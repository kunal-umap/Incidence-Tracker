# ==============================================================================
# Enterprise Python & PostgreSQL Platform Configuration
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
PROJECT_NAME="Enterprise Python Auth & Agent Platform"
DEBUG=true
API_V1_STR="/api/v1"

# Security & JWT Tokens
# Generate secure key with: openssl rand -hex 32
SECRET_KEY=e83a9926c4f03d6d5ef109b83b3e2185481d9f826354b3ad386b0daef4e0a417
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration (Used by Docker Compose & Async SQLAlchemy)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=appuser
POSTGRES_PASSWORD=supersecretpassword123!
POSTGRES_DB=enterprise_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Constructed Async Database URI for SQLAlchemy + asyncpg
# When running outside docker, replace 'postgres' with 'localhost'
DATABASE_URL=postgresql+asyncpg://appuser:supersecretpassword123!@postgres:5432/enterprise_db

# Redis Configuration (Used for caching, rate limiting, session store, agent queues)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# AI Agent Service Configuration
AI_AGENT_TIMEOUT_SECONDS=120
GEMINI_API_KEY=
DEFAULT_AI_MODEL=gemini-2.5-flash

# CORS Allowed Origins (Comma separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
